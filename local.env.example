# Copy this file to local.env and put in your values: local.env stays outside Git.
# Bundle identifier of the Mac app: keep it the same after the first launch,
# because macOS ties permissions to it (microphone, screen, accessibility…).
JARVIS_BUNDLE_ID=com.example.jarvis
# Bundle identifier of the iPhone and iPad app.
JARVIS_IPHONE_BUNDLE_ID=com.example.jarvis.iphone
# Team ID of your Apple account (Xcode › Settings › Accounts), to install on iPhone and iPad.
JARVIS_TEAM=
